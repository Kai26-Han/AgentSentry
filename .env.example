# Copy to .env and replace every CHANGE_ME value before starting.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://agentsentry:CHANGE_ME@db:5432/agentsentry
REDIS_URL=redis://redis:6379/0
AGENTSENTRY_PORT=8000
ADMIN_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_WITH_A_RANDOM_32_BYTE_SECRET
AGENT_API_KEY=CHANGE_ME_WITH_A_RANDOM_32_BYTE_SECRET
JUDGE_PROVIDER=mock
JUDGE_SCORE_THRESHOLD=0.7
ALERT_COOLDOWN_SECONDS=600
WEBHOOK_URL=
WEBHOOK_SECRET=
# Cloud providers are opt-in. Never put real credentials in sample data.
JUDGE_OPENAI_BASE_URL=
JUDGE_OPENAI_API_KEY=
JUDGE_OPENAI_MODEL=
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional advisory output review. Only a local OpenAI-compatible endpoint is accepted.
OUTPUT_LOCAL_MODEL_BASE_URL=
OUTPUT_LOCAL_MODEL_NAME=
# V3.0：可选的目标偏移语义提示；只接受显式配置的本地 OpenAI 兼容 HTTP 端点。
# 默认关闭。此模型仅提供线索，不参与工具授权或审批。
GOAL_LOCAL_MODEL_BASE_URL=
GOAL_LOCAL_MODEL_NAME=
# V2.5: defaults to on. Both preview and metadata persist generated memory text.
AGENTSENTRY_MEMORY_ENABLED=true
# V2.7：设为 true 后，工具调用必须携带由会话开始接口签发的绑定凭据。
# V3.3 行动链额度只覆盖带有效绑定凭据的工具调用。所有调用方完成接入后将此项设为 true，
# 否则旧客户端仍可绕过行动链额度；已有策略、权限和运行时规则继续生效。
AGENTSENTRY_RUNTIME_BINDING_REQUIRED=false
# V2.8：示例 Agent 模型请求的本地目的地；须与 Agent 端 DEMO_MODEL_BASE_URL 完全一致。
AGENTSENTRY_MODEL_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# 远程模型默认不登记。值为目的地 ID 到 HTTPS 基础 URL 的 JSON 对象。
AGENTSENTRY_MODEL_REMOTE_DESTINATIONS={}
# V3.2：远程 MCP 默认不登记。按租户配置固定 HTTPS 地址、OAuth 客户端及审批后的
# tools/list 清单 SHA-256；完整 JSON 格式见 docs/remote-mcp.md。
AGENTSENTRY_REMOTE_MCP_REGISTRY={}
# 可信 MCP 适配层显式展示远程固定工具；只有网关登记且策略允许后才能调用。
AGENTSENTRY_REMOTE_MCP_ENABLED=false
# 仅本机受控演示可显式开启；正式远程端点始终要求公网 HTTPS 地址。
AGENTSENTRY_REMOTE_MCP_ALLOW_LOOPBACK_DEMO=false
# GitHub 官方 MCP 只读测试：固定读取公开许可证与公开 Issue #3213。
# PAT 只放在本机私有 .env，不复制到文档或日志；默认关闭。
AGENTSENTRY_GITHUB_MCP_ENABLED=false
GITHUB_MCP_PAT=
# 真实 GitHub Issue 写入实验：独立、仅指定测试仓库 Issues 写权限的 PAT。
# 先保持关闭；不要重用上方的只读测试凭据。
AGENTSENTRY_GITHUB_MCP_WRITE_ENABLED=false
GITHUB_MCP_WRITE_PAT=
GITHUB_MCP_TEST_REPO=
# 使用 scripts/probe_github_create_issue_shape.py 只读核对工具定义后人工填写。
GITHUB_MCP_CREATE_ISSUE_SCHEMA_SHA256=
